        "message": "=<div style=\"background:#f4f6f8;padding:24px 0;font-family:Arial,Helvetica,sans-serif;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border-radius:8px;overflow:hidden;\">\n<tr><td style=\"background:#1a56db;padding:28px 32px;color:#ffffff;\">\n<h1 style=\"margin:0;font-size:24px;\">Welcome to the Team, {{ $json.Full_Name }}!</h1>\n<p style=\"margin:8px 0 0;font-size:14px;opacity:.9;\">{{ $json.Role_Title }} &middot; {{ $json.Department }} &middot; ID {{ $json.Employee_ID }}</p>\n</td></tr>\n<tr><td style=\"padding:28px 32px;color:#1f2937;font-size:15px;line-height:1.6;\">\n<p>Hi {{ $json.Full_Name }},</p>\n<p>We are thrilled to have you join us as <b>{{ $json.Role_Title }}</b>. Below is your personalised onboarding package: <b>{{ $json.Kit_Title }}</b>.</p>\n<h3 style=\"margin:24px 0 8px;color:#1a56db;\">Your Setup Checklist</h3>\n<ul style=\"padding-left:20px;margin:0;\">{{ $json.Setup_Instructions }}</ul>\n<h3 style=\"margin:24px 0 8px;color:#1a56db;\">Your Point of Contact</h3>\n<p style=\"margin:0;\">{{ $json.Department_Mentor }}</p>\n<p style=\"text-align:center;margin:32px 0;\"><a href=\"{{ $json.Handbook_Link }}\" style=\"background:#1a56db;color:#ffffff;padding:12px 28px;border-radius:6px;text-decoration:none;font-weight:bold;display:inline-block;\">Open Your Handbook</a></p>\n<p>Welcome aboard,<br><b>The HR Team</b></p>\n</td></tr>\n<tr><td style=\"background:#f9fafb;padding:16px 32px;font-size:12px;color:#6b7280;text-align:center;\">This is an automated onboarding message. Please reply to your HR contact for any questions.</td></tr>\n</table></td></tr></table></div>",
